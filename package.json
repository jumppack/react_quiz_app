{
  "name": "stepful-quiz-workspace",
  "version": "1.0.0",
  "description": "Quiz App React + Express Workspace",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm install --prefix client && npm install --prefix server",
    "start:client": "npm run dev --prefix client",
    "start:server": "npm start --prefix server",
    "dev": "concurrently \"npm run start:client\" \"npm run start:server\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
